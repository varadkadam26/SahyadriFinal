<%- include('partials/header') %>

  <style>
    .committee-hero {
      background: var(--temple-maroon);
      color: var(--bg-ivory);
      padding: 4.5rem 0;
      border-bottom: 3px solid var(--royal-gold);
      text-align: center;
    }

    .committee-hero h1 {
      font-size: 3rem;
      color: var(--gold-soft);
      margin: 0.7rem 0 0;
    }

    .committee-hero p {
      font-size: 1.1rem;
      color: #E5E7EB;
      max-width: 850px;
      margin: 1rem auto 0;
      line-height: 1.8;
    }

    .committee-year {
      display: inline-block;
      margin-top: 1rem;
      padding: 0.5rem 1.2rem;
      border: 1px solid var(--royal-gold);
      border-radius: 999px;
      color: var(--gold-soft);
      background: rgba(212, 175, 55, 0.15);
      font-weight: 800;
    }

    .committee-section {
      padding: 5rem 0;
    }

    .committee-heading {
      text-align: center;
      margin-bottom: 3.5rem;
    }

    .committee-heading h2 {
      font-size: 2.2rem;
      color: var(--temple-maroon);
      margin-bottom: 0.5rem;
    }

    .committee-heading p {
      color: var(--text-muted);
      font-size: 1rem;
    }

    .committee-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .committee-card {
      position: relative;
      background: #ffffff;
      border: 1px solid var(--border-subtle);
      border-top: 4px solid var(--royal-gold);
      border-radius: var(--radius-lg);
      padding: 2rem 1.5rem;
      text-align: center;
      box-shadow: var(--shadow-sm);
      min-height: 330px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      box-sizing: border-box;
    }

    .committee-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-md);
    }

    .committee-number {
      position: absolute;
      top: 14px;
      right: 14px;

      width: 38px;
      height: 38px;

      border-radius: 50%;

      background: var(--temple-maroon);
      color: var(--gold-soft);

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 0.9rem;
      font-weight: 800;
    }

    .committee-icon {
      width: 96px;
      height: 96px;

      border-radius: 50%;
      border: 3px solid var(--royal-gold);

      background: linear-gradient(to bottom, #FFF8EC, #FCE8D5, #EEDFC5);

      display: flex;
      align-items: center;
      justify-content: center;

      margin: 0 auto 1.2rem;
      overflow: hidden;
      box-shadow: 0 4px 12px rgba(180, 140, 60, 0.15);
      box-sizing: border-box;
      flex-shrink: 0;
      position: relative;
    }

    .committee-icon img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center 20%;
      display: block !important;
    }

    .committee-icon i {
      font-size: 2.5rem;
      color: var(--temple-maroon);
    }


    .committee-name-marathi {
      font-family: var(--font-mr, "Baloo 2", serif);
      color: var(--temple-maroon);
      font-size: 1.2rem;
      font-weight: 800;
      line-height: 1.4;
      margin-bottom: 0.25rem;
      min-height: 2.8rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .committee-name-english {
      color: var(--text-muted);
      font-family: var(--font-en, "Outfit", sans-serif);
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.4;
      margin-bottom: 0.8rem;
      min-height: 2.4rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .committee-designation-marathi {
      color: var(--primary-saffron);
      font-family: var(--font-mr, "Baloo 2", serif);
      font-size: 1rem;
      font-weight: 800;
      line-height: 1.5;
    }

    .committee-designation-english {
      color: var(--text-muted);
      font-family: var(--font-en, "Outfit", sans-serif);
      font-size: 0.85rem;
      font-weight: 700;
      line-height: 1.5;
    }

    .committee-divider {
      width: 70%;
      height: 1px;
      background: var(--border-subtle);
      margin: 0.7rem auto;
    }

    .committee-note {
      margin-top: 3.5rem;

      background: #ffffff;
      border: 2px solid var(--royal-gold);
      border-radius: var(--radius-lg);

      padding: 2rem;

      text-align: center;

      box-shadow: var(--shadow-sm);
    }

    .committee-note h3 {
      color: var(--temple-maroon);
      margin-bottom: 0.7rem;
    }

    .committee-note p {
      color: var(--text-muted);
      margin: 0;
      line-height: 1.8;
    }


    @media (max-width: 1000px) {

      .committee-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

    }


    @media (max-width: 650px) {

      .committee-hero {
        padding: 3.5rem 1rem;
      }

      .committee-hero h1 {
        font-size: 2.2rem;
      }

      .committee-section {
        padding: 3.5rem 0;
      }

      .committee-grid {
        grid-template-columns: 1fr;
        gap: 1.2rem;
      }

      .committee-card {
        min-height: auto;
        padding: 1.8rem 1.2rem;
      }

      .committee-name-marathi {
        font-size: 1.1rem;
      }

    }
  </style>


  <!-- ==========================================
     COMMITTEE HERO
========================================== -->

  <section class="page-hero-banner">
    <div class="container">
      <h1>
        <span class="lang-mr">कार्यकारिणी समिती</span>
        <span class="lang-en">Executive Committee</span>
      </h1>
    </div>
  </section>



  <!-- ==========================================
     COMMITTEE MEMBERS
========================================== -->

  <section class="committee-section">

    <div class="container">


      <div class="committee-heading">

        <h2 class="committee-name-marathi lang-mr">मंडळाचे पदाधिकारी</h2>
        <h2 class="committee-name-english lang-en" style="color: var(--temple-maroon); font-weight: 800; font-family: var(--font-en, 'Outfit', sans-serif);">Mandal Office Bearers</h2>
        
        <p class="committee-name-marathi lang-mr" style="color: var(--text-muted); font-size: 1.1rem; max-width: 600px; margin: 0.5rem auto 0;">
          सन २०२६-२७ साठी नियुक्त पदाधिकारी
        </p>
        <p class="committee-name-english lang-en" style="color: var(--text-muted); font-size: 1.1rem; max-width: 600px; margin: 0.5rem auto 0; font-family: var(--font-en, 'Outfit', sans-serif);">
          Office Bearers for the Year 2026-27
        </p>

        <div class="gold-divider"></div>

      </div>



      <div class="committee-grid">


        <% committeeData.forEach(member=> { %>


          <div class="committee-card">


            <!-- NUMBER -->

            <div class="committee-number">
              <%= member.number %>
            </div>


            <!-- MEMBER ICON -->

            <div class="committee-icon">
              <% if (member.image) { %>
                <img src="<%= member.image %>" alt="<%= member.nameEn %>" style="width: 100%; height: 100%; object-fit: cover; object-position: <%= member.objectPosition || 'center 20%' %>;">
              <% } else { %>
                <i class="fa-solid fa-user-tie"></i>
              <% } %>
            </div>


            <!-- MARATHI NAME -->

            <div class="committee-name-marathi lang-mr">
              <%= member.nameMr %>
            </div>


            <!-- ENGLISH NAME -->

            <div class="committee-name-english lang-en">
              <%= member.nameEn %>
            </div>


            <div class="committee-divider"></div>


            <!-- MARATHI DESIGNATION -->

            <div class="committee-designation-marathi lang-mr">
              <%= member.designationMr %>
            </div>


            <!-- ENGLISH DESIGNATION -->

            <div class="committee-designation-english lang-en">
              <%= member.designationEn %>
            </div>


          </div>


          <% }); %>


      </div>





    </div>

  </section>


  <%- include('partials/footer') %>