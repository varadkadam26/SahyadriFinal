                  data-lang="mr"
                  style="color: #FFE8C2 !important; text-shadow: 1px 1px 0px #1B0B28, -1px -1px 0px #1B0B28, 1px -1px 0px #1B0B28, -1px 1px 0px #1B0B28, 2px 2px 5px rgba(0,0,0,0.8) !important; background: transparent !important; margin: 0;">मराठी</button>
                <button class="lang-btn <%= typeof lang === 'undefined' || lang === 'en' ? 'active' : '' %>"
                  data-lang="en"
                  style="color: #FFE8C2 !important; text-shadow: 1px 1px 0px #1B0B28, -1px -1px 0px #1B0B28, 1px -1px 0px #1B0B28, -1px 1px 0px #1B0B28, 2px 2px 5px rgba(0,0,0,0.8) !important; background: transparent !important; margin: 0;">English</button>
