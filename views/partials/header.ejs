<% 
  const pageLang = typeof lang !== 'undefined' ? lang : 'mr';
  const activeKey = typeof activeTab !== 'undefined' ? activeTab : 'home';
  const currentPath = typeof reqPath !== 'undefined' ? reqPath : '/';
  const seo = typeof seoConfig !== 'undefined' ? seoConfig.getPageSEO(activeKey, pageLang, currentPath) : {
    title: typeof title !== 'undefined' ? title : 'Sahyadri Krida Mandal',
    description: 'Official Portal of Sahyadri Krida Mandal.',
    canonicalUrl: 'https://sahyadrikridamandal.com' + currentPath,
    image: 'https://sahyadrikridamandal.com/images/sahyadri-ganpati-01.jpg',
    schemas: []
  };
%>
<!DOCTYPE html>
<html lang="<%= pageLang === 'mr' ? 'mr-IN' : 'en-IN' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#800020">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Sahyadri Krida Mandal">

  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <meta name="robots" content="<%= typeof noindex !== 'undefined' && noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' %>">
  <meta name="google-site-verification" content="RPYCXxWBarYuzv4WD-WXYm9lrrQQHtpTywUuRhj2sbQ">
  <link rel="canonical" href="<%= seo.canonicalUrl %>">

  <!-- Open Graph & Social Sharing Meta Tags -->
  <meta property="og:site_name" content="Sahyadri Krida Mandal">
  <meta property="og:title" content="<%= seo.title %>">
  <meta property="og:description" content="<%= seo.description %>">
  <meta property="og:image" content="<%= seo.image %>">
  <meta property="og:url" content="<%= seo.canonicalUrl %>">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="<%= pageLang === 'mr' ? 'mr_IN' : 'en_IN' %>">

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= seo.title %>">
  <meta name="twitter:description" content="<%= seo.description %>">
  <meta name="twitter:image" content="<%= seo.image %>">

  <!-- JSON-LD Structured Data Schemas -->
  <% seo.schemas.forEach(schemaObj => { %>
    <script type="application/ld+json">
      <%- JSON.stringify(schemaObj) %>
    </script>
  <% }); %>

  <!-- Google Web Fonts & Devanagari Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Noto+Serif+Devanagari:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400&family=Rozha+One&family=Baloo+2:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- FontAwesome & Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Swiper.js & GSAP -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <!-- Internationalization System -->
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('mcc_lang');
        var cookieMatch = document.cookie.match(/mcc_lang=(mr|en)/);
        var l = saved || (cookieMatch ? cookieMatch[1] : '<%= typeof lang !== "undefined" ? lang : "en" %>');
        document.documentElement.lang = l;
        document.documentElement.setAttribute('data-lang', l);
        document.cookie = "mcc_lang=" + l + "; path=/; max-age=31536000; SameSite=Lax";
      } catch (e) { }
    })();
  </script>
  <script src="/js/i18n.js"></script>
  <!-- Sahyadri Krida Mandal Stylesheet -->
  <link rel="stylesheet" href="/css/style.css?v=1.0.0">

  <style>
    /* UNIFIED SINGLE SECTION HEADER - FORCIBLY MERGE TOPBAR AND NAVBAR */
    .site-header {
      position: sticky !important;
      top: 0 !important;
      z-index: 1000 !important;
      background: linear-gradient(to bottom, #1B0B28, #5A246F) !important;
      backdrop-filter: blur(16px) !important;
      border-bottom: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .topbar-chintamani,
    #topUtilityBar,
    .top-utility-bar {
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
      border: none !important;
      border-bottom: none !important;
      box-shadow: none !important;
      padding: 7px 0 2px 0 !important;
      color: #FFE8C2 !important;
      text-shadow: 1px 1px 0px #2A114B, -1px -1px 0px #2A114B, 1px -1px 0px #2A114B, -1px 1px 0px #2A114B, 2px 2px 4px rgba(0, 0, 0, 0.6) !important;
      margin: 0 !important;
    }

    .mandal-top-banner-flex {
      border: none !important;
      margin: 0 !important;
    }

    .topbar-chintamani,
    .topbar-chintamani *,
    .topbar-chintamani .lang-btn,
    .topbar-chintamani .lang-btn.active {
      color: #FFE8C2 !important;
      text-shadow: 1px 1px 0px #1B0B28, -1px -1px 0px #1B0B28, 1px -1px 0px #1B0B28, -1px 1px 0px #1B0B28, 2px 2px 5px rgba(0, 0, 0, 0.8) !important;
      border: none !important;
    }

    .header-inner {
      padding: 0.35rem 0 0.65rem 0 !important;
      border: none !important;
      border-top: none !important;
      margin: 0 auto !important;
    }

    .nav-live-btn,
    .nav-live-btn i,
    .nav-donate-btn,
    .main-nav a,
    .main-nav span,
    .nav-link {
      color: #FFE8C2 !important;
      text-shadow: 1px 1px 0px #1B0B28, -1px -1px 0px #1B0B28, 1px -1px 0px #1B0B28, -1px 1px 0px #1B0B28, 2px 2px 5px rgba(0, 0, 0, 0.8) !important;
    }

    /* Glowing Luxury Suvarna Mahotsav 50 Years Emblem */
    @keyframes suvarnaGoldPulse {
      0% {
        filter: drop-shadow(0 6px 22px rgba(245, 158, 11, 0.85)) drop-shadow(0 0 45px rgba(212, 175, 55, 0.5));
        transform: translateY(0) scale(1);
      }

      50% {
        filter: drop-shadow(0 8px 35px rgba(255, 200, 55, 1)) drop-shadow(0 0 70px rgba(245, 158, 11, 0.9)) drop-shadow(0 0 22px rgba(255, 255, 255, 0.75));
        transform: translateY(-8px) scale(1.04);
      }

      100% {
        filter: drop-shadow(0 6px 22px rgba(245, 158, 11, 0.85)) drop-shadow(0 0 45px rgba(212, 175, 55, 0.5));
        transform: translateY(0) scale(1);
      }
    }

    .hero-suvarna-right {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      flex: 0 0 auto;
      margin-right: clamp(3rem, 7.5vw, 8.5rem);
      text-align: center;
    }

    .suvarna-grand-emblem {
      height: clamp(140px, 15vw, 210px);
      width: auto;
      object-fit: contain;
      animation: suvarnaGoldPulse 3.5s ease-in-out infinite;
      transition: transform 0.4s ease, filter 0.4s ease;
      user-select: none;
      cursor: pointer;
    }

    .suvarna-grand-emblem:hover {
      transform: scale(1.08) translateY(-8px);
      filter: drop-shadow(0 10px 45px rgba(255, 215, 0, 1)) drop-shadow(0 0 85px rgba(245, 158, 11, 0.95));
    }

    @media (max-width: 992px) {
      .hero-suvarna-right {
        margin-right: clamp(1rem, 4vw, 3rem);
      }

      .suvarna-grand-emblem {
        height: clamp(100px, 13vw, 150px) !important;
      }
    }

    /* ==========================================================================
       LAPTOP / DESKTOP (STRICTLY >= 769px) - 100% UNTOUCHED
       ========================================================================== */
    @media (min-width: 769px) {
      .hero-desktop-content {
        display: contents !important;
      }

      .hero-mobile-content {
        display: none !important;
      }
    }

    /* ==========================================================================
       MOBILE ONLY (STRICTLY <= 768px) - 100% EXACT REPLICA OF USER SCREENSHOT
       ========================================================================== */
    @media (max-width: 768px) {
      .hero-desktop-content {
        display: none !important;
      }

      .hero-carousel {
        height: 100vh !important;
        height: 100dvh !important;
        max-height: 850px !important;
        min-height: 620px !important;
        position: relative !important;
        overflow: hidden !important;
      }

      .hero-slide-bg {
        filter: brightness(0.68) contrast(1.05) saturate(1.08) !important;
      }

      /* Precise mobile alignment & framing for each slideshow photo */
      .hero-carousel .hero-slide-bg.hero-img-4 {
        object-position: 50% 5% !important;
      }

      .hero-carousel .hero-slide-bg.hero-img-5 {
        object-position: 76% 28% !important;
      }

      .hero-carousel .hero-slide-bg.hero-img-6 {
        object-position: 77% 12% !important;
      }

      .hero-mobile-content {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        position: absolute !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
        width: 90% !important;
        max-width: 380px !important;
        z-index: 10 !important;
        pointer-events: auto !important;
      }

      /* 1. 50 Years Emblem */
      .m-suvarna-img {
        height: 64px !important;
        width: auto !important;
        object-fit: contain !important;
        filter: drop-shadow(0 4px 14px rgba(245, 158, 11, 0.9)) drop-shadow(0 0 25px rgba(212, 175, 55, 0.5)) !important;
        margin-bottom: 0.25rem !important;
      }

      /* 2. Main Title */
      .m-hero-title {
        font-family: 'Outfit', 'Baloo 2', sans-serif !important;
        font-size: 1.55rem !important;
        font-weight: 800 !important;
        color: #FFFFFF !important;
        text-shadow: 0 3px 12px rgba(0, 0, 0, 0.9) !important;
        margin: 0 0 0.2rem 0 !important;
        text-align: center !important;
        line-height: 1.2 !important;
        white-space: normal !important;
      }

      /* 3. Subtitle */
      .m-hero-subtitle {
        font-family: var(--font-en-head) !important;
        font-size: 0.62rem !important;
        font-weight: 700 !important;
        color: #D4AF37 !important;
        letter-spacing: 1.2px !important;
        text-transform: uppercase !important;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.95) !important;
        margin: 0 0 0.9rem 0 !important;
        text-align: center !important;
        line-height: 1.35 !important;
        white-space: normal !important;
      }

      /* 4. Two Buttons */
      .m-hero-actions {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 0.75rem !important;
        width: 100% !important;
        margin-bottom: 0.9rem !important;
      }

      /* Left Button: Pill with Golden Glowing Ring */
      .m-btn-live {
        background: #381749 !important;
        color: #FFFFFF !important;
        border-radius: 9999px !important;
        border: 1.5px solid rgba(234, 179, 8, 0.7) !important;
        box-shadow: 0 0 16px rgba(234, 179, 8, 0.4) !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 7px !important;
        height: 44px !important;
        font-weight: 800 !important;
        font-size: 0.8rem !important;
        text-decoration: none !important;
        padding: 0 0.5rem !important;
        white-space: nowrap !important;
      }

      .m-play-triangle {
        color: #FFFFFF !important;
        font-size: 0.75rem !important;
      }

      /* Right Button: Rounded rectangle with 3D Drop Shadow */
      .m-btn-donate {
        background: #381749 !important;
        color: #FFFFFF !important;
        border-radius: 14px !important;
        border: none !important;
        box-shadow: 3px 3px 0px #000000 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        height: 44px !important;
        font-weight: 800 !important;
        font-size: 0.86rem !important;
        text-decoration: none !important;
        padding: 0 0.5rem !important;
        white-space: nowrap !important;
      }

      /* 5. Countdown Card (100% Transparent, Gold Outline) */
      .m-countdown-card {
        width: 100% !important;
        border: 1.5px solid rgba(212, 175, 55, 0.75) !important;
        border-radius: 18px !important;
        background: transparent !important;
        box-shadow: none !important;
        padding: 1rem 0.85rem 1.15rem 0.85rem !important;
        text-align: center !important;
        box-sizing: border-box !important;
      }

      .m-countdown-pill {
        display: inline-block !important;
        border: 1px solid rgba(212, 175, 55, 0.8) !important;
        border-radius: 9999px !important;
        padding: 3px 14px !important;
        margin-bottom: 0.7rem !important;
        background: transparent !important;
        color: #FFFFFF !important;
        font-weight: 800 !important;
        font-size: 0.72rem !important;
        letter-spacing: 0.5px !important;
        text-transform: uppercase !important;
      }

      .m-countdown-title {
        font-family: 'Playfair Display', 'Cinzel', serif !important;
        font-weight: 800 !important;
        font-size: 1.15rem !important;
        color: #FFFFFF !important;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9) !important;
        margin: 0 0 0.85rem 0 !important;
        letter-spacing: 0.5px !important;
        line-height: 1.25 !important;
      }

      .m-timer-grid {
        display: grid !important;
        grid-template-columns: repeat(4, 1fr) !important;
        gap: 0.45rem !important;
      }

      .m-timer-box {
        border: 1.5px solid rgba(212, 175, 55, 0.75) !important;
        border-radius: 12px !important;
        padding: 0.45rem 0.1rem !important;
        background: transparent !important;
        text-align: center !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
      }

      .m-timer-val {
        color: #FDE68A !important;
        font-size: 1.45rem !important;
        font-weight: 800 !important;
        line-height: 1 !important;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8) !important;
      }

      .m-timer-label {
        color: #FBBF24 !important;
        font-size: 0.62rem !important;
        font-weight: 800 !important;
        margin-top: 4px !important;
        letter-spacing: 0.5px !important;
        text-transform: uppercase !important;
      }

      /* 6. Carousel Dots - REMOVED */
      .hero-carousel-dots {
        display: none !important;
      }
    }
  </style>

  <!-- Canvas Confetti Library for Festive Celebration -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <link rel="icon" type="image/png" href="/images/sahyadri_logo_transparent.png">
</head>

<body>

  <!-- Studio Custom Interactive Follower Cursor -->
  <div class="custom-cursor-dot" id="customCursorDot"></div>
  <div class="custom-cursor-outline" id="customCursorOutline"></div>

  <!-- Main Site Sticky Header -->
  <header class="site-header">
    <!-- Mandal Top Header Banner -->
    <div class="topbar-chintamani top-utility-bar" id="topUtilityBar">
      <div class="container">
        <div class="mandal-top-banner-flex">
          <!-- Top Meta (Est & Reg & Social Links) -->
          <div class="mandal-top-meta"
            style="color: #FFE8C2 !important; text-shadow: 1px 1px 0px #1B0B28, -1px -1px 0px #1B0B28, 1px -1px 0px #1B0B28, -1px 1px 0px #1B0B28, 2px 2px 5px rgba(0,0,0,0.8) !important;">
            <span class="est-text" style="color: inherit !important; text-shadow: inherit !important;">
