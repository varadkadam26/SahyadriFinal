                <i class="fa-brands fa-instagram"
                  style="color: inherit !important; text-shadow: inherit !important;"></i> <span class="insta-full"
                  style="color: inherit !important; text-shadow: inherit !important;">@sahyadrikridamandal.r</span><span
                  class="insta-short"
