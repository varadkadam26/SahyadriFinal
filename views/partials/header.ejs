              <span class="lang-en" style="color: inherit !important; text-shadow: inherit !important;">Reg. No. F/7624
                (Mumbai)</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="container header-inner">
      <!-- Official Mandal Logo Crest with Motion Frame -->
      <a href="/" class="brand-logo" style="margin-left: 12px;">
        <div class="logo-motion-wrapper">
          <div class="logo-motion-ring"></div>
          <img src="/images/sahyadri_logo_transparent.png" alt="Sahyadri Krida Mandal Logo"
            style="width: 100%; height: 100%; object-fit: contain; position: relative; z-index: 1;">
        </div>
        <div class="brand-text" style="display: flex; align-items: center; margin-left: 15px;">
          <style>
            .sahyadri-text-logo {
              height: 32px;
              width: auto;
              object-fit: contain;
              margin-top: 3px;
              transition: all 0.3s ease;
              /* Golden Light Yellow (#FFE8C2) with glow */
              filter: brightness(0) saturate(100%) invert(88%) sepia(21%) saturate(928%) hue-rotate(335deg) brightness(106%) contrast(105%) drop-shadow(0 0 10px rgba(255, 232, 194, 0.8));
            }

            @media (min-width: 768px) {
              .sahyadri-text-logo {
                height: 40px;
                margin-top: 5px;
              }
            }
          </style>
          <img src="/images/sahyadri_text_logo_mr_transparent.png" class="sahyadri-text-logo"
            alt="सह्याद्री क्रीडा मंडळ (न्यास)">
        </div>

      </a>

      <!-- Navigation Links -->
      <nav class="main-nav" id="mainNav">
        <ul>
          <li>
            <a href="https://www.youtube.com/@sahyadrikridamandal.r" target="_blank" rel="noopener noreferrer"
              class="btn btn-outline nav-live-btn">
              <i class="fa-solid fa-tower-broadcast" style="color: var(--primary-saffron);"></i>
              <span class="lang-mr">थेट दर्शन</span>
              <span class="lang-en">LIVE DARSHAN</span>
            </a>
          </li>
          <li><a href="/" class="nav-link <%= activeTab === 'home' ? 'active' : '' %>" style="white-space: nowrap;">
              <span class="lang-mr">मुखपृष्ठ</span><span class="lang-en">Home</span>
            </a></li>
          <li><a href="/about" class="nav-link <%= activeTab === 'about' ? 'active' : '' %>" style="white-space: nowrap;">
              <span class="lang-mr">आमच्याबद्दल</span><span class="lang-en">About Us</span>
            </a></li>
          <li><a href="/schedule" class="nav-link <%= activeTab === 'schedule' ? 'active' : '' %>" style="white-space: nowrap;">
              <span class="lang-mr">वेळापत्रक</span><span class="lang-en">Schedule</span>
            </a></li>
          <li><a href="/glimpses" class="nav-link <%= activeTab === 'glimpses' || activeTab === 'photobooth' ? 'active' : '' %>" style="white-space: nowrap;">
              <span class="lang-mr">क्षणचित्रे</span><span class="lang-en">Glimpses</span>
            </a></li>
          <li><a href="/social-work" class="nav-link <%= activeTab === 'socialwork' ? 'active' : '' %>" style="white-space: nowrap;">
