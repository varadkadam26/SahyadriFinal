<%- include('partials/header') %>

<!-- Page Hero Banner -->
<section class="page-hero-banner">
  <div class="container">
    <h1 data-i18n="adv_page_title">
      <span class="lang-mr">जाहिरात</span>
      <span class="lang-en">Advertisement</span>
    </h1>
  </div>
</section>

<!-- Advertisement Content -->
<section style="padding: 4rem 0;">
  <div class="container">
    
    <!-- Information Section -->
    <div class="adv-info-section" style="background: var(--surface-bg); border: 1px solid rgba(197, 160, 89, 0.2); border-radius: 12px; padding: 2rem; margin-bottom: 3rem; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
      <h2 style="color: var(--primary-saffron); margin-bottom: 1.5rem; text-align: center; font-family: 'Cinzel', serif;">Join Us as a Sponsor</h2>
      
      <ul style="list-style: none; padding: 0; margin-bottom: 2rem; line-height: 1.8; font-size: 1.1rem; color: #333;">
        <li style="margin-bottom: 1rem;">We have approximately <strong>1 Lakh devotees</strong> visiting our pandal every day.</li>
        <li style="margin-bottom: 1rem;">We have arranged Special Entry for <strong>Senior Citizens, Differently-abled persons and school children</strong>.</li>
        <li style="margin-bottom: 1rem;">We have <strong>50,000 Plus</strong> followers on our Facebook page.</li>
        <li style="margin-bottom: 1rem;">Our videos, live aartis are viewed by <strong>lakhs of people</strong> everyday.</li>
        <li style="margin-bottom: 1rem;">This gives an opportunity to the sponsors to join with us for their advertisements, connect and reach to the customers and consumers.</li>
        <li style="margin-bottom: 1rem;">We offer all above sites for branding with <strong>non-objectionable product or presentation avoiding Political touch</strong>, branding must reach to heart of every person of this country.</li>
      </ul>
    </div>

    <!-- Advertisement Sites Gallery -->
    <div class="adv-gallery" style="margin-top: 4rem;">
      <h2 style="text-align: center; color: var(--temple-maroon); margin-bottom: 2.5rem; font-family: 'Cinzel', serif;">Our Advertisement Sites</h2>
      
      <div style="margin-bottom: 3rem;">
        <img src="/images/adv/gates.jpg" alt="Gates Advertising" style="width: 100%; mix-blend-mode: multiply;">
      </div>

      <div style="margin-bottom: 3rem;">
        <img src="/images/adv/hoardings.jpg" alt="Hoardings Around Sahyadri Ground" style="width: 100%; mix-blend-mode: multiply;">
      </div>

      <div style="margin-bottom: 3rem;">
        <img src="/images/adv/other.jpg" alt="Other Branding Locations" style="width: 100%; mix-blend-mode: multiply;">
      </div>

    </div>

  </div>
</section>


<%- include('partials/footer') %>
