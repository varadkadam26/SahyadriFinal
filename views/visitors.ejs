  <style>
    /* ============ VISITORS PAGE STYLES ============ */

    /* Category Toggle Buttons */
    .visitors-toggle-bar {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin: 2.5rem auto 2rem;
      max-width: 520px;
    }

    .visitors-toggle-btn {
      flex: 1;
      max-width: 240px;
      padding: 0.85rem 1.6rem;
      font-family: 'Outfit', 'Baloo 2', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      border: 2px solid var(--royal-gold, #C9A227);
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      background: transparent;
      color: var(--royal-gold, #C9A227);
      position: relative;
      overflow: hidden;
    }

    .visitors-toggle-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, var(--temple-maroon, #800020), #4A0E2B);
      opacity: 0;
      transition: opacity 0.35s ease;
      z-index: 0;
    }

    .visitors-toggle-btn > * {
      position: relative;
      z-index: 1;
    }

    .visitors-toggle-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(201, 162, 39, 0.25);
    }

    .visitors-toggle-btn.active {
      color: #FDE68A;
      border-color: var(--royal-gold, #C9A227);
      box-shadow: 0 0 24px rgba(201, 162, 39, 0.35), inset 0 0 12px rgba(201, 162, 39, 0.1);
    }

    .visitors-toggle-btn.active::before {
      opacity: 1;
    }

    .visitors-toggle-btn i {
      font-size: 1.15rem;
    }

    /* Section Panels */
    .visitors-panel {
      display: none;
      animation: visitorsFadeIn 0.5s ease forwards;
    }

    .visitors-panel.active {
      display: block;
    }

    @keyframes visitorsFadeIn {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Photo Grid */
    .visitors-gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.8rem;
      padding: 0;
    }

    .visitor-photo-card {
      background: var(--bg-white, #FFFFFF);
      border-radius: 16px;
      border: 1.5px solid var(--border-gold, rgba(201, 162, 39, 0.3));
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease;
    }

    .visitor-photo-card:hover {
      transform: translateY(-6px) scale(1.015);
      box-shadow: 0 12px 36px rgba(201, 162, 39, 0.2), 0 4px 12px rgba(0, 0, 0, 0.1);
    }

    .visitor-photo-card .card-img-wrap {
      width: 100%;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: #F5F0E8;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .visitor-photo-card .card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
      transition: transform 0.5s ease;
    }

    .visitor-photo-card:hover .card-img-wrap img {
      transform: scale(1.05);
    }

    /* Empty State for Celebrities */
    .visitors-coming-soon {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--temple-maroon, #800020);
    }

    .visitors-coming-soon i {
      font-size: 3.5rem;
      color: var(--royal-gold, #C9A227);
      margin-bottom: 1.2rem;
      display: block;
      opacity: 0.7;
    }

    .visitors-coming-soon h3 {
      font-family: 'Outfit', 'Baloo 2', sans-serif;
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 0.6rem;
    }

    .visitors-coming-soon p {
      font-size: 1rem;
      color: #777;
      max-width: 400px;
      margin: 0 auto;
    }

    /* Lightbox Modal */
    .visitor-lightbox {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(0, 0, 0, 0.92);
      align-items: center;
      justify-content: center;
      padding: 2rem;
      cursor: zoom-out;
    }

    .visitor-lightbox.open {
      display: flex;
    }

    .visitor-lightbox img {
      max-width: 90vw;
      max-height: 85vh;
      border-radius: 12px;
      box-shadow: 0 8px 48px rgba(0, 0, 0, 0.6);
      object-fit: contain;
    }

    .visitor-lightbox-close {
      position: absolute;
      top: 1.2rem;
      right: 1.5rem;
      background: none;
      border: none;
      color: #FDE68A;
      font-size: 2rem;
      cursor: pointer;
      z-index: 10;
      transition: transform 0.3s ease;
    }

    .visitor-lightbox-close:hover {
      transform: scale(1.2) rotate(90deg);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .visitors-toggle-bar {
        margin: 1.5rem 1rem 1.5rem;
        gap: 0.75rem;
      }

      .visitors-toggle-btn {
        padding: 0.7rem 1rem;
        font-size: 0.92rem;
      }

      .visitors-gallery-grid {
        grid-template-columns: 1fr 1fr;
        gap: 0.85rem;
      }

      .visitor-photo-card .card-img-wrap {
        aspect-ratio: 1 / 1;
      }
    }

    @media (max-width: 420px) {
      .visitors-gallery-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .visitor-photo-card .card-img-wrap {
        aspect-ratio: 4 / 3;
      }
    }
  </style>

