  <!-- Lightbox Modal -->
  <div class="visitor-lightbox" id="visitorLightbox" onclick="closeVisitorLightbox()">
    <button class="visitor-lightbox-close" onclick="closeVisitorLightbox()" aria-label="Close">&times;</button>
    <img id="visitorLightboxImg" src="" alt="Visitor Photo">
  </div>

  <script>
    // Tab Switching
    function switchVisitorTab(tab) {
      document.querySelectorAll('.visitors-toggle-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.target === tab);
      });
      document.querySelectorAll('.visitors-panel').forEach(panel => {
        panel.classList.remove('active');
      });
      const targetPanel = document.getElementById('panel-' + tab);
      if (targetPanel) {
        targetPanel.classList.add('active');
      }
    }

    // Lightbox Open/Close
    function openVisitorLightbox(card) {
      const img = card.querySelector('img');
      if (!img) return;
      const lb = document.getElementById('visitorLightbox');
      const lbImg = document.getElementById('visitorLightboxImg');
      lbImg.src = img.src;
      lb.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeVisitorLightbox() {
      const lb = document.getElementById('visitorLightbox');
      lb.classList.remove('open');
      document.body.style.overflow = '';
    }

    // Close lightbox on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeVisitorLightbox();
    });
  </script>

