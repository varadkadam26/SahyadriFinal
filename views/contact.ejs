<%- include('partials/header') %>

<section class="page-hero-banner">
  <div class="container">
    <h1>
      <span class="lang-mr">संपर्क</span>
      <span class="lang-en">Contact</span>
    </h1>
  </div>
</section>

<section class="main-content-gradient" style="padding: 5rem 0;">
  <div class="container">
    
    <div class="grid-2" style="margin-bottom: 4rem;">
      <!-- Contact Info Box -->
      <div class="card-temple" style="padding: 2.5rem;">
        <h2 style="font-size: 1.8rem; color: var(--temple-maroon); margin-bottom: 0.5rem; border-left: 4px solid var(--royal-gold); padding-left: 1rem;">
          <span class="lang-mr">सह्याद्री क्रीडा मंडळ (न्यास)</span>
          <span class="lang-en">Sahyadri Krida Mandal (Trust)</span>
        </h2>


        <!-- Registered Office -->
        <div style="margin-bottom: 1.5rem; white-space: nowrap; overflow-x: auto; padding-bottom: 4px;">
          <strong style="color: var(--primary-saffron); font-size: 1.05rem; margin-right: 0.5rem;">
            <i class="fa-solid fa-building" style="margin-right: 6px;"></i> 
            <span class="lang-mr">नोंदणीकृत कार्यालय (Registered Office):</span>
            <span class="lang-en">Registered Office:</span>
          </strong>
          <span style="color: var(--text-muted); font-size: 0.98rem;">
            <span class="lang-mr">सहकार प्लाझा सिनेमागृह शेजारी, टिळकनगर, मुंबई - ४०००८९.</span>
            <span class="lang-en">Next to Sahakar Plaza Cinema, Tilak Nagar, Chembur, Mumbai - 400089.</span>
          </span>
        </div>

        <!-- Contact Office -->
        <div style="margin-bottom: 1.5rem; white-space: nowrap; overflow-x: auto; padding-bottom: 4px;">
          <strong style="color: var(--primary-saffron); font-size: 1.05rem; margin-right: 0.5rem;">
            <i class="fa-solid fa-location-dot" style="margin-right: 6px;"></i> 
            <span class="lang-mr">संपर्क कार्यालय (Contact Office):</span>
            <span class="lang-en">Contact Office:</span>
          </strong>
          <span style="color: var(--text-muted); font-size: 0.98rem;">
            <span class="lang-mr">वृंदावन सोसायटी परिसर, एल/४/३२ शेजारी, टिळकनगर, मुंबई - ४०००८९.</span>
            <span class="lang-en">Vrundavan Society Campus, Next to L/4/32, Tilak Nagar, Mumbai - 400089.</span>
          </span>
        </div>

        <!-- Emergency & Help Desk -->
        <div style="margin-bottom: 1.5rem; white-space: nowrap; overflow-x: auto; padding-bottom: 4px;">
          <strong style="color: var(--primary-saffron); font-size: 1.05rem; margin-right: 0.5rem;">
            <i class="fa-solid fa-phone" style="margin-right: 6px;"></i> 
            <span class="lang-mr">आपत्कालीन व मदत केंद्र:</span>
            <span class="lang-en">Emergency & Help Desk:</span>
          </strong>
          <span style="color: var(--text-muted); font-size: 0.98rem;">
            <span class="lang-mr">फोन: +९१ ९६१९१ ०८८६६ | व्हॉट्सॲप: +९१ ९६१९१ ०८८६६</span>
            <span class="lang-en">Phone: +91 96191 08866 | WhatsApp: +91 96191 08866</span>
          </span>
        </div>

        <!-- Official Email & Website -->
        <div style="margin-bottom: 1.5rem; white-space: nowrap; overflow-x: auto; padding-bottom: 4px;">
          <strong style="color: var(--primary-saffron); font-size: 1.05rem; margin-right: 0.5rem;">
            <i class="fa-solid fa-envelope" style="margin-right: 6px;"></i> 
            <span class="lang-mr">अधिकृत ईमेल व वेबसाईट:</span>
            <span class="lang-en">Official Email & Website:</span>
          </strong>
          <span style="color: var(--text-muted); font-size: 0.98rem;">
            <strong>Email:</strong> sahyadrikm.r@gmail.com | <strong>Website:</strong> www.sahyadrikridamandal.com
          </span>
        </div>
      </div>

      <!-- Contact Inquiry Form -->
      <div class="card-temple" style="padding: 2.5rem;">
        <h2 style="font-size: 1.8rem; color: var(--temple-maroon); margin-bottom: 1.5rem;">
          <span class="lang-mr">संदेश पाठवा</span>
          <span class="lang-en">Send a Message</span>
        </h2>

        <form id="contactForm">
          <div style="margin-bottom: 1.2rem;">
            <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--text-main);">
              <span class="lang-mr">तुमचे नाव *</span>
              <span class="lang-en">Your Name *</span>
            </label>
            <input type="text" id="cName" required placeholder="संपूर्ण नाव टाका / Enter Full Name" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;">
          </div>

          <div style="margin-bottom: 1.2rem;">
            <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--text-main);">
              <span class="lang-mr">ईमेल पत्ता *</span>
              <span class="lang-en">Email Address *</span>
            </label>
            <input type="email" id="cEmail" required placeholder="ईमेल पत्ता टाका | Enter Email Address" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;">
          </div>

          <div style="margin-bottom: 1.5rem;">
            <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--text-main);">
              <span class="lang-mr">तुमचा संदेश / प्रश्न *</span>
              <span class="lang-en">Your Message / Query *</span>
            </label>
            <textarea id="cMessage" rows="4" required placeholder="येथे संदेश लिहा... / Write your message here..." style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;"></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.85rem; font-size: 1.05rem;">
            <span class="lang-mr">मंडळाला संदेश पाठवा</span>
            <span class="lang-en">Send Message to Mandal</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Embedded Google Maps at Bottom -->
    <div style="background: var(--bg-white); border-radius: var(--radius-lg); border: 2px solid var(--royal-gold); padding: 2rem; box-shadow: var(--shadow-md);">
      <h3 style="font-size: 1.6rem; color: var(--temple-maroon); margin-bottom: 1rem; text-align: center;">
        <span class="lang-mr">गूगल मॅप्स - मण्डप स्थान (Sahyadri)</span>
        <span class="lang-en">Google Maps - Mandap Location (Sahyadri)</span>
      </h3>

      <div style="width: 100%; height: 400px; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border-gold);">
        <iframe 
          src="https://www.google.com/maps?q=Bhaji+Galli%2C+Shankar+Sheth+Road%2C+Grant+Road%2C+Mumbai-400007&output=embed" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>

  </div>
</section>

<script>
  document.getElementById('contactForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector('button[type="submit"]');
    const originalHTML = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span>संदेश पाठवत आहे... / Sending...</span>';

    const name = document.getElementById('cName').value.trim();
    const email = document.getElementById('cEmail').value.trim();
    const message = document.getElementById('cMessage').value.trim();

    if (!name || !email || !message) {
      alert('कृपया वैध ईमेल पत्ता व सर्व माहिती भरा. / Please enter a valid email and fill all required fields.');
      btn.disabled = false;
      btn.innerHTML = originalHTML;
      return;
    }

    try {
      const res = await fetch('/contact/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, contact: email, message })
      });
      const data = await res.json();

      if (data.success) {
        alert(data.message || 'तुमचा संदेश यशस्वीरित्या पाठवला गेला आहे!');
        document.getElementById('contactForm').reset();
      } else {
        alert(data.message || 'संदेश पाठवताना त्रुटी आली.');
      }
    } catch (err) {
      console.error('Contact form error:', err);
      alert('सर्व्हरशी कनेक्ट करता आले नाही. कृपया पुन्हा प्रयत्न करा.');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalHTML;
    }
  });
</script>

<%- include('partials/footer') %>
